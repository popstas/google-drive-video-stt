# Comma-separated list of Google Drive folder IDs to monitor
FOLDER_IDS=

# Polling interval in seconds (default: 600)
POLL_INTERVAL=600

# MP3 audio bitrate (default: 96k)
BITRATE=96k

# Telegram bot credentials for error notifications (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Directory holding credentials.json and token.json (default: data)
# Note: temporary MP4/MP3 files use the system temp dir, not this path.
DATA_DIR=data

# Optional proxy URL for Telegram notifications and OpenAI STT
# Supported schemes: http, https, socks5
# PROXY_URL=socks5://user:password@proxy-host:1080

# Speech-to-text provider: "" (disabled), "openai", "google", or "asr"
# "asr" uses self-hosted whisper-asr-webservice (https://github.com/ahmetoner/whisper-asr-webservice)
STT_PROVIDER=

# Optional language hint for STT (e.g. "en", "ru"). Leave empty for auto-detect.
STT_LANGUAGE=

# STT chunk length in seconds (default: 600). Tune to keep chunks under provider size limits.
STT_CHUNK_SECONDS=600

# Required when STT_PROVIDER=openai
OPENAI_API_KEY=

# Required when STT_PROVIDER=google
# GOOGLE_CLOUD_PROJECT is your GCP project id; GOOGLE_APPLICATION_CREDENTIALS is path to service-account JSON.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Required when STT_PROVIDER=asr
# Base URL of the whisper-asr-webservice instance (without trailing /asr)
# ASR_URL=http://localhost:9000
