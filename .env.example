# NOTE: .env is only read once, to seed data/config.yml on the first run (or via
# `gdstt config migrate`). After that, data/config.yml is the source of truth and
# these variables are ignored. OPENAI_KEYPOINTS seeds the built-in `keypoints`
# preset; edit data/config.yml to add or customize presets.

# Comma-separated list of Google Drive folder IDs to monitor
FOLDER_IDS=

# Polling interval in seconds (default: 600)
POLL_INTERVAL=600

# MP3 audio bitrate (default: 96k)
BITRATE=96k

# Upload an MP3 artifact next to the MP4.
# Defaults to false for DEEPGRAM_AUDIO_SOURCE=m4a_copy (Deepgram uses a temporary
# M4A copy and does not need a Drive MP3), and true otherwise.
# DRIVE_MP3_ARTIFACT=

# Telegram bot credentials for error notifications (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Directory holding credentials.json and token.json (default: data)
# Note: temporary MP4/MP3 files use the system temp dir, not this path.
DATA_DIR=data

# Optional proxy URL for Telegram notifications, Deepgram, and OpenAI keypoints.
# Supported schemes: http, https, socks5
# PROXY_URL=socks5://user:password@proxy-host:1080

# Speech-to-text provider: "deepgram" (default) or "disabled".
# "deepgram" uses Deepgram Nova-3 with diarization (`diarize_model=latest`).
# Set STT_PROVIDER=disabled to skip transcription and only manage MP3 artifacts.
STT_PROVIDER=deepgram

# Language hint for STT.
# - deepgram: optional; empty defaults to "ru" for Russian with Nova-3.
STT_LANGUAGE=

# Post-process the raw transcript before writing it (default: true). Cleans
# whitespace, maps diarized "Speaker N" labels to the interlocutor names parsed
# from the video file name, and merges any extra (spurious) speakers.
# STT_POSTPROCESS=true

# Where transcript/keypoints artifacts are written: "drive" (sibling files next to
# the MP4, default) or "folder" (local OUTPUT_DIR).
# OUTPUT_TARGET=drive
# Required when OUTPUT_TARGET=folder. Local directory for transcript/keypoints files;
# created if missing.
# OUTPUT_DIR=

# Generate a <base>.keypoints.md Keypoints document (## Задачи / ## Тезисы /
# ## Открытые вопросы) via the OpenAI Responses API after transcription.
# Requires OPENAI_API_KEY.
# OPENAI_KEYPOINTS=false
OPENAI_API_KEY=
# Model used for keypoints generation.
# OPENAI_MODEL=gpt-5.4-mini
# Submit keypoints generation via the OpenAI Batch API (~50% cheaper, higher latency).
# OPENAI_BATCH=false
# Max number of independent presets run concurrently (maps to openai.max_parallel).
# OPENAI_MAX_PARALLEL=4

# Required when STT_PROVIDER=deepgram.
# DEEPGRAM_API_KEY has priority. Alternatively set DEEPGRAM_API_KEY_FILE to a file
# containing either a raw token or JSON with api_key/deepgram_api_key/DEEPGRAM_API_KEY.
# Deepgram Nova/Base/Enhanced sync requests that process for over 10 minutes can return 504;
# callback mode is not implemented in this service yet.
DEEPGRAM_API_KEY=
# DEEPGRAM_API_KEY_FILE=/run/secrets/deepgram_api_key

# Deepgram tuning.
# Defaults are optimized for Russian technical interviews with diarization.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_DIARIZE_MODEL=latest
# DEEPGRAM_AUDIO_SOURCE=m4a_copy  # m4a_copy, mp3_96k, or mp3_192k
# DEEPGRAM_TXT_FORMATTER=word_speaker
# DEEPGRAM_KEYTERMS_ENABLED=true
# DEEPGRAM_KEYTERMS_FILE=config/deepgram-keyterms.txt
