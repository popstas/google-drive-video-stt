# Comma-separated list of Google Drive folder IDs to monitor
FOLDER_IDS=

# Polling interval in seconds (default: 600)
POLL_INTERVAL=600

# MP3 audio bitrate (default: 96k)
BITRATE=96k

# Telegram bot credentials for error notifications (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Directory holding credentials.json and token.json (default: data)
# Note: temporary MP4/MP3 files use the system temp dir, not this path.
DATA_DIR=data

# Optional proxy URL for Telegram notifications, OpenAI STT, ASR, and Deepgram STT
# Supported schemes: http, https, socks5
# PROXY_URL=socks5://user:password@proxy-host:1080

# Speech-to-text provider: "" (disabled), "openai", "google", "asr", or "deepgram"
# "asr" uses self-hosted whisper-asr-webservice (https://github.com/ahmetoner/whisper-asr-webservice)
# "deepgram" uses Deepgram Nova-3 with diarization (`diarize_model=latest`)
STT_PROVIDER=

# Language hint for STT.
# - openai/asr: optional (e.g. "en", "ru"); empty = auto-detect.
# - deepgram: optional; empty defaults to "ru" for Russian with Nova-3.
# - google: REQUIRED; must be a BCP-47 code (e.g. "en-US", "ru-RU"). The `long`
#   model used for diarization does not support auto-detection.
STT_LANGUAGE=

# STT chunk length in seconds (default: 600). Tune to keep chunks under provider size limits.
# Ignored when STT_PROVIDER=google or STT_PROVIDER=deepgram (full-file transcription).
STT_CHUNK_SECONDS=600

# Post-process the raw transcript before upload (default: true). Cleans whitespace,
# maps diarized "Speaker N" labels to the interlocutor names parsed from the video
# file name, and merges any extra (spurious) speakers into the real ones.
# STT_POSTPROCESS=true

# Required when STT_PROVIDER=openai
OPENAI_API_KEY=

# Required when STT_PROVIDER=deepgram.
# DEEPGRAM_API_KEY has priority. Alternatively set DEEPGRAM_API_KEY_FILE to a file
# containing either a raw token or JSON with api_key/deepgram_api_key/DEEPGRAM_API_KEY.
# Deepgram Nova/Base/Enhanced sync requests that process for over 10 minutes can return 504;
# callback mode is not implemented in this service yet.
DEEPGRAM_API_KEY=
# DEEPGRAM_API_KEY_FILE=/run/secrets/deepgram_api_key

# Deepgram tuning.
# Defaults are optimized for Russian technical interviews with diarization.
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_DIARIZE_MODEL=latest
# DEEPGRAM_AUDIO_SOURCE=m4a_copy  # m4a_copy, mp3_96k, or mp3_192k
# DEEPGRAM_TXT_FORMATTER=word_speaker
# DEEPGRAM_KEYTERMS_ENABLED=true
# DEEPGRAM_KEYTERMS_FILE=config/deepgram-keyterms.txt

# Required when STT_PROVIDER=google
# Uses the same Google OAuth user credentials as Drive (no service account).
# After enabling, re-run `python -m src.auth` once so the new cloud-platform scope is granted.
# GOOGLE_CLOUD_PROJECT is your GCP project id.
# GOOGLE_STT_GCS_BUCKET is the GCS bucket used to stage MP3 uploads for BatchRecognize
# (create with `gsutil mb -l us gs://<bucket>`); blobs are deleted after each run.
# Output is diarized: `[HH:MM:SS] Speaker N: ...` lines.
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_GCS_BUCKET=

# Required when STT_PROVIDER=asr
# Base URL of the whisper-asr-webservice instance (without trailing /asr)
# ASR_URL=http://localhost:9000
